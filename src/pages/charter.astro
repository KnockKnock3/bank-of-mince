import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Charter">
  <section class="hero">
    <p class="eyebrow">THE BANK OF MINCE</p>
    <h1>The Charter of the Bank of Mince</h1>
    <p class="lead">
      The rules, responsibilities and authority under which the Bank of Mince operates.
    </p>
  </section>

  <nav class="charter-toc card" aria-label="Charter contents">
    <h2>Contents</h2>
    <ol>
      <li><a href="#section-i">Purpose of the Bank</a></li>
      <li><a href="#section-ii">Currency and Treasury</a></li>
      <li><a href="#section-iii">Taxation and Monetary Control</a></li>
      <li><a href="#section-iv">Audits and Inspections</a></li>
      <li><a href="#section-v">Bonds, Loans, and Accounts</a></li>
      <li><a href="#section-vi">Emergency Economic Powers</a></li>
      <li><a href="#section-vii">Governance and Public Oversight</a></li>
      <li><a href="#section-viii">Amendments</a></li>
    </ol>
  </nav>

  <section class="section charter-section" id="section-i">
    <h2>Section I — Purpose of the Bank</h2>

    <div class="charter-subsection">
      <h3>1.1 Primary Objectives</h3>
      <p>
        The Bank of Mince shall act as the central monetary authority
        of the server economy. The Bank shall pursue the following objectives:
      </p>
      <ol>
        <li>To maintain a stable and functional economy.</li>
        <li>To preserve the value and stability of the currency.</li>
        <li>To encourage the frequent exchange of goods and services.</li>
        <li>To support long-term economic planning and sustainable growth.</li>
        <li>To prevent excessive inflation, inequality, and economic collapse.</li>
      </ol>
    </div>

    <div class="charter-subsection">
      <h3>1.2 Transparency and Monetary Integrity</h3>
      <p>
        The Bank shall operate on principles of transparency and full
        reserve backing. The following practices are prohibited:
      </p>
      <ol>
        <li>Fiat currency creation without declared public backing and policy justification.</li>
        <li>Fractional reserve banking or unbacked lending.</li>
        <li>Concealment of state reserves, taxation, or monetary operations.</li>
      </ol>
      <p>
        The Bank treasury and monetary policies shall remain publicly inspectable.
      </p>
    </div>

    <div class="charter-subsection">
      <h3>1.3 Role of the Governor</h3>
      <p>
        The Governor of the Bank shall oversee the daily operations of
        the Bank and enact policies consistent with this Charter and
        the current public mandate. The Governor shall possess operational
        independence except where restricted by motions passed under Section VII.
      </p>
    </div>
  </section>

  <section class="section charter-section" id="section-ii">
    <h2>Section II — Currency and Treasury</h2>

    <div class="charter-subsection">
      <h3>2.1 Official Currency</h3>
      <p>
        Raw Beef shall constitute the official state currency unless
        replaced under emergency monetary measures.
      </p>
    </div>

    <div class="charter-subsection">
      <h3>2.2 State Treasury</h3>
      <p>
        The Bank shall maintain a treasury containing state reserves
        of currency and other state-owned strategic assets. The treasury
        may be used for:
      </p>
      <ol>
        <li>Loan issuance.</li>
        <li>Bond repayment.</li>
        <li>Economic stabilisation.</li>
        <li>Emergency interventions.</li>
        <li>Public expenditure programmes.</li>
        <li>Funding state organisations.</li>
        <li>Strategic state investment.</li>
      </ol>
      <p>
        The Governor may deploy treasury assets for the purposes listed
        in this Charter, provided such actions are consistent with the
        current public mandate and the economic objectives of the Bank.
      </p>
    </div>
  </section>

  <section class="section charter-section" id="section-iii">
    <h2>Section III — Taxation and Monetary Control</h2>

    <div class="charter-subsection">
      <h3>3.1 Meat Production Tax</h3>
      <p>
        The Bank shall maintain a progressive taxation system on raw
        meat production.
      </p>
    </div>

    <div class="charter-subsection">
      <h3>3.2 Production Tax Structure</h3>
      <ol>
        <li>A tax-free allowance shall apply each week.</li>
        <li>Production exceeding the allowance shall be taxed at rates determined by the Bank.</li>
        <li>A soft production limit may be established, above which a 100% marginal tax rate shall apply.</li>
      </ol>
    </div>

    <div class="charter-subsection">
      <h3>3.3 Purpose of Taxation</h3>
      <p>Taxation shall serve primarily as a mechanism for:</p>
      <ol>
        <li>Inflation control.</li>
        <li>Prevention of excessive currency production.</li>
        <li>Limitation of economic inequality.</li>
        <li>Maintenance of economic balance.</li>
        <li>Accumulation of state reserves.</li>
        <li>Funding public projects and strategic investments.</li>
      </ol>
    </div>

    <div class="charter-subsection">
      <h3>3.4 Interest Income Tax</h3>
      <p>
        The Bank may impose a tax upon interest income received from
        bonds, deposits, or other financial instruments, in a manner
        similar to meat production taxation.
      </p>
    </div>

    <div class="charter-subsection">
      <h3>3.5 Policy Announcements</h3>
      <p>
        Any changes to taxation, tax thresholds, interest rates, deposit
        rates, bond rates, and other standing monetary policies must be
        publicly announced before Saturday 00:00 UK time and shall take
        effect beginning Monday 00:00 UK time. Emergency measures enacted
        under Section VI are exempt from this requirement.
      </p>
    </div>
  </section>

  <section class="section charter-section" id="section-iv">
    <h2>Section IV — Audits and Inspections</h2>

    <div class="charter-subsection">
      <h3>4.1 Inspection Authority</h3>
      <p>
        The Bank may conduct inspections or audits of persons, businesses,
        and government organisations for the purposes of:
      </p>
      <ol>
        <li>Recording currency ownership.</li>
        <li>Enforcing taxation.</li>
        <li>Monitoring currency production.</li>
        <li>Investigating suspected fraud or undeclared reserves.</li>
      </ol>
    </div>

    <div class="charter-subsection">
      <h3>4.2 Conduct of Audits</h3>
      <p>
        Audits shall be conducted reasonably and transparently.
        Abusing inspection powers for personal gain shall constitute malpractice.
      </p>
    </div>
  </section>

  <section class="section charter-section" id="section-v">
    <h2>Section V — Bonds, Loans, and Accounts</h2>

    <div class="charter-subsection">
      <h3>5.1 Government Bonds</h3>
      <p>
        The Bank may issue sovereign bonds to remove currency from
        circulation, fund expenditure, or stabilise the economy.
      </p>

      <div class="charter-subsection charter-subsection-nested">
        <h4>5.1.1 Coupon Bonds</h4>
        <p>
          Coupon bonds shall provide periodic interest payments with
          principal repaid at maturity.
        </p>
      </div>

      <div class="charter-subsection charter-subsection-nested">
        <h4>5.1.2 Zero-Coupon Bonds</h4>
        <p>
          Zero-coupon bonds shall repay principal and accumulated
          interest together at maturity.
        </p>
      </div>
    </div>

    <div class="charter-subsection">
      <h3>5.2 Loans</h3>
      <p>
        The Bank may issue loans to persons, businesses, and government organisations.
      </p>

      <div class="charter-subsection charter-subsection-nested">
        <h4>5.2.1 Standard Loans</h4>
        <p>
          Standard loans shall require fixed periodic interest payments
          until the principal is repaid.
        </p>
      </div>

      <div class="charter-subsection charter-subsection-nested">
        <h4>5.2.2 Alternative Repayment Agreements</h4>
        <p>
          The Governor may authorise alternative repayment structures
          where deemed economically beneficial. Abuse of this power
          for personal gain shall be considered malpractice.
        </p>
      </div>

      <div class="charter-subsection charter-subsection-nested">
        <h4>5.2.3 Restrictions on Self-Dealing</h4>
        <p>
          The Governor may not issue loans to themselves or their
          businesses below the current base interest rate. Issuing
          such loans is considered malpractice.
        </p>
      </div>
    </div>

    <div class="charter-subsection">
      <h3>5.3 Secured and Limited Liability Lending</h3>

      <div class="charter-subsection charter-subsection-nested">
        <h4>5.3.1 Personal Loans</h4>
        <p>
          Personal loans may be secured against personal assets.
        </p>
      </div>

      <div class="charter-subsection charter-subsection-nested">
        <h4>5.3.2 Business and Government Loans</h4>
        <p>
          Limited liability loans may be issued to businesses and
          government organisations. Such loans shall be secured only
          against the assets of the relevant borrowing organisation,
          and shall not create any personal liability.
        </p>
      </div>
    </div>

    <div class="charter-subsection">
      <h3>5.4 Accounts and Deposits</h3>
      <p>
        The Bank may offer accounts to persons, businesses, and government
        organisations. These accounts may:
      </p>
      <ol>
        <li>Hold currency deposits.</li>
        <li>Facilitate transfers.</li>
        <li>Receive interest payments.</li>
        <li>Be used for automated bond or loan payments.</li>
      </ol>
      <p>
        The Bank may offer deposit interest rates to encourage saving
        during inflationary periods.
      </p>
    </div>
  </section>

  <section class="section charter-section" id="section-vi">
    <h2>Section VI — Emergency Economic Powers</h2>

    <div class="charter-subsection">
      <h3>6.1 Emergency Monetary Measures</h3>
      <p>
        During periods of severe inflation, economic collapse, or
        monetary instability, the Bank may:
      </p>
      <ol>
        <li>Temporarily prohibit slaughter.</li>
        <li>Introduce replacement currencies.</li>
        <li>Conduct state buy-back schemes.</li>
        <li>Impose temporary emergency controls.</li>
      </ol>
    </div>

    <div class="charter-subsection">
      <h3>6.2 Use of Emergency Powers</h3>
      <p>
        Emergency powers shall be temporary and proportionate to
        the economic threat.
      </p>
    </div>
  </section>

  <section class="section charter-section" id="section-vii">
    <h2>Section VII — Governance and Public Oversight</h2>

    <div class="charter-subsection">
      <h3>7.1 Economic Coordination Meetings</h3>

      <div class="charter-subsection charter-subsection-nested">
        <h4>7.1.1 Policy Meetings</h4>
        <p>
          The Bank shall hold bi-weekly policy coordination meetings,
          where practical, with relevant economic and governmental parties.
        </p>
      </div>

      <div class="charter-subsection charter-subsection-nested">
        <h4>7.1.2 Economic Summits</h4>
        <p>
          The Bank shall hold monthly economic summits, where practical,
          open to all players for discussion of long-term economic goals
          and public mandates.
        </p>
      </div>
    </div>

    <div class="charter-subsection">
      <h3>7.2 Public Mandate</h3>
      <p>
        The Governor shall seek to operate the Bank in accordance with
        the broad economic mandate established through public discussion
        and summit agreements.
      </p>
    </div>

    <div class="charter-subsection">
      <h3>7.3 Motions Against the Governor</h3>

      <div class="charter-subsection charter-subsection-nested">
        <h4>7.3.1 Motions of Opposition</h4>
        <p>
          Players may raise motions opposing specific Bank policies
          or decisions. If supported by a majority vote, the Governor
          must reverse, suspend, or abandon the contested policy.
        </p>
      </div>

      <div class="charter-subsection charter-subsection-nested">
        <h4>7.3.2 Motions of No Confidence</h4>
        <p>
          Players may raise motions of no confidence in cases of severe
          malpractice, abuse of power, corruption, or sustained failure
          to uphold the Charter. If supported by a majority vote:
        </p>
        <ol>
          <li>The Governor shall be forced to immediately resign.</li>
          <li>A new election shall be held.</li>
          <li>The former Governor may stand for re-election. This shall constitute an appeal.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section charter-section" id="section-viii">
    <h2>Section VIII — Amendments</h2>

    <div class="charter-subsection">
      <h3>8.1 Amendment Procedure</h3>
      <p>
        This Charter may be amended through majority vote at an Economic
        Summit or through another agreed constitutional mechanism.
      </p>
    </div>
  </section>
</BaseLayout>
